generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique

  username  String?
  avatarUrl String?

  githubId String? @unique
  githubUsername String?

  githubInstallationId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  reviews       PullRequestReview[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
}

model PullRequestReview {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  owner      String
  repo       String
  pullNumber Int
  pullTitle  String?

  provider String
  model    String

  score          Int
  summary        String
  issues         Json
  positivePoints Json

  totalFiles    Int
  analyzedFiles Int

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, owner, repo, pullNumber])
}
